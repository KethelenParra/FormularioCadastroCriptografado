# Banco de dados PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crud_dados_pessoais
DATABASE_USER=postgres
DATABASE_PASSWORD=COLOCAR_SENHA_LOCAL

# Chave AES-256 (32 bytes em Base64 urlsafe)
# Gere com: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AES_KEY=COLOCAR_CHAVE_GERADA

# CORS — frontend Vite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
